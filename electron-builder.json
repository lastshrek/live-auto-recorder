{
  "appId": "com.live-recorder.app",
  "productName": "直播自动录制",
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    "src/**/*",
    "package.json",
    "!**/logs/**",
    "!**/recordings/**",
    "!**/work/**",
    "!**/dist/**",
    "!**/.workbuddy-ai/**",
    "!**/*.log",
    "!config.json",
    "!config.json.*",
    "!history.json",
    "!history.json.*",
    "!recording-jobs.json",
    "!recording-jobs.json.*"
  ],
  "extraResources": [
    {
      "from": "启动直播录制.command",
      "to": "启动直播录制.command"
    },
    {
      "from": "使用说明-macOS.md",
      "to": "使用说明-macOS.md"
    }
  ],
  "asar": true,
  "asarUnpack": [
    "node_modules/ffmpeg-static/**"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}-${version}-win-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "deleteAppDataOnUninstall": false
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      }
    ],
    "category": "public.app-category.video",
    "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
    "extendInfo": {
      "LSUIElement": false,
      "NSHighResolutionCapable": true
    }
  },
  "dmg": {
    "title": "${productName} ${version}"
  }
}
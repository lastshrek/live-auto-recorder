{
  "name": "live-recorder",
  "productName": "直播自动录制",
  "version": "0.1.0",
  "description": "多主播开播监控 + 自动原画录制",
  "main": "src/bootstrap.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "electron tests/electron/ui-test.cjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "transcribe:setup": "node scripts/setup-transcribe.cjs",
    "transcribe:check": "node scripts/setup-transcribe.cjs --check",
    "transcribe": "node scripts/transcribe-cli.cjs",
    "install:win": "node scripts/install-windows.cjs",
    "icon": "python3 scripts/icon/gen-icon.py"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "optionalDependencies": {
    "ntsuspend": "1.0.2"
  }
}
